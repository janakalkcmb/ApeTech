    <!-- JAVASCRIPT -->
    <script>
        // --- SCROLL ANIMATION LOGIC ---
        const observerOptions = { root: null, rootMargin: '0px', threshold: 0.1 };
        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('active');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);
        document.querySelectorAll('.reveal').forEach((el) => { observer.observe(el); });

        // --- LOGIN LOGIC ---
        let loginType = 'client'; // 'client' or 'admin'

        function openLogin(type) {
            loginType = type;
            const modal = document.getElementById('loginModal');
            const title = document.getElementById('login-title');
            const subtitle = document.getElementById('login-subtitle');
            const errorMsg = document.getElementById('login-error');
            
            // Reset form
            document.getElementById('loginForm').reset();
            errorMsg.style.display = 'none';

            if (type === 'admin') {
                title.innerText = "Administrator Login";
                subtitle.innerText = "Secure access for Apesoft staff.";
                // For demo purposes, auto-fill the admin credentials
                document.getElementById('login-email').value = "admin@apesoft.com";
                document.getElementById('login-password').value = "admin123";
            } else {
                title.innerText = "Client Portal Login";
                subtitle.innerText = "Access your Apesoft applications.";
            }

            modal.style.display = 'flex';
        }

        function closeLogin() {
            document.getElementById('loginModal').style.display = 'none';
        }

        function handleLogin(event) {
            event.preventDefault();
            const email = document.getElementById('login-email').value;
            const password = document.getElementById('login-password').value;
            const errorMsg = document.getElementById('login-error');

            // Simulated Authentication Logic
            if (loginType === 'admin') {
                // Hardcoded admin credentials for demo
                if (email === 'admin@apesoft.com' && password === 'admin123') {
                    closeLogin();
                    // Open Admin Dashboard
                    document.getElementById('input-hero-title').value = document.getElementById('hero-title').innerText;
                    document.getElementById('input-hero-subtitle').value = document.getElementById('hero-subtitle').innerText;
                    document.getElementById('adminModal').style.display = 'flex';
                } else {
                    errorMsg.innerText = "Invalid Admin Credentials. Try: admin@apesoft.com / admin123";
                    errorMsg.style.display = 'block';
                }
            } else {
                // Simulated Client Login (accepts any valid-looking email/pass)
                if (email.length > 5 && password.length >= 6) {
                    closeLogin();
                    alert("Welcome back! Redirecting to your Apesoft Client Dashboard...\n\n(Note: This is a front-end demo. In a real app, this would redirect to the specific SaaS platform).");
                } else {
                    errorMsg.innerText = "Please enter a valid email and password (min 6 characters).";
                    errorMsg.style.display = 'block';
                }
            }
        }

        // --- DETAILS MODAL LOGIC ---
        function showDetails(title, subtitle, description, featuresArray) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-subtitle').innerText = subtitle;
            document.getElementById('modal-desc').innerText = description;

            const actionBtn = document.getElementById('modal-action-btn');
            if(title.includes('Coming Soon') || subtitle === 'Coming Soon') {
                actionBtn.innerText = "Notify Me When Available";
                actionBtn.style.backgroundColor = "var(--accent-color)";
                actionBtn.style.color = "var(--primary-color)";
            } else {
                actionBtn.innerText = "Request Information / Get a Quote";
                actionBtn.style.backgroundColor = "var(--secondary-color)";
                actionBtn.style.color = "white";
            }

            const featuresList = document.getElementById('modal-features');
            featuresList.innerHTML = ''; 
            featuresArray.forEach(feature => {
                const li = document.createElement('li');
                li.innerText = feature;
                featuresList.appendChild(li);
            });

            document.getElementById('detailsModal').style.display = 'flex';
        }

        function closeDetails() {
            document.getElementById('detailsModal').style.display = 'none';
        }

        // --- ADMIN PORTAL SAVE LOGIC ---
        function closeAdmin() {
            document.getElementById('adminModal').style.display = 'none';
        }

        function saveChanges() {
            document.getElementById('hero-title').innerText = document.getElementById('input-hero-title').value;
            document.getElementById('hero-subtitle').innerText = document.getElementById('input-hero-subtitle').value;
            closeAdmin();
            alert("Website content updated successfully from Admin Dashboard!");
        }

        // Close modals if user clicks outside of the content box
        window.onclick = function(event) {
            const detailsModal = document.getElementById('detailsModal');
            const adminModal = document.getElementById('adminModal');
            const loginModal = document.getElementById('loginModal');
            
            if (event.target === detailsModal) closeDetails();
            if (event.target === adminModal) closeAdmin();
            if (event.target === loginModal) closeLogin();
        }
    </script>
